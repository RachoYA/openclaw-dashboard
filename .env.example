# Dashboard frontend port (default: 3100)
DASHBOARD_PORT=3100

# BFF WebSocket server port (default: 3101)
BFF_PORT=3101

# Redis port (default: 6390, mapped to internal 6379)
REDIS_PORT=6390

# OpenClaw Gateway URLs
VITE_API_URL=http://localhost:18789
VITE_WS_URL=ws://localhost:3101

# BFF config
POLL_INTERVAL=10000
OPENCLAW_BIN=openclaw
REDIS_URL=redis://redis:6379
