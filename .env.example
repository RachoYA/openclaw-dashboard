# Dashboard Frontend
VITE_BFF_WS_URL=ws://localhost:3101    # BFF WebSocket URL (auto-detected if empty)

# BFF Service
PORT=3101                               # BFF HTTP + WebSocket port
POLL_INTERVAL=10000                     # OpenClaw polling interval (ms)
OPENCLAW_BIN=openclaw                   # Path to openclaw binary
REDIS_URL=redis://localhost:6379        # Redis connection URL
GITHUB_TOKEN=                           # GitHub API token (optional, increases rate limit)
GITHUB_REPOS=RachoYA/openclaw-dashboard # Comma-separated repos for metrics

# Docker
DASHBOARD_PORT=3100                     # Nginx port
BFF_PORT=3101                           # BFF exposed port
