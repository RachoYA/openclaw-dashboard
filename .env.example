# OpenClaw Dashboard — Environment Variables

# WebSocket URL (relative or absolute)
# Relative: /db/ws (production, через nginx proxy)
# Absolute: ws://localhost:3101 (local development)
VITE_WS_URL=/db/ws

# Default theme: light | dark
VITE_THEME=light

# BFF Server port
BFF_PORT=3101

# OpenClaw Gateway (для BFF)
# OPENCLAW_GATEWAY_URL=http://localhost:3100

# GitHub Token (для метрик: PRs, issues, commits)
# Без токена: 60 req/hour, приватные репо недоступны
# С токеном: 5000 req/hour, все репо
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
